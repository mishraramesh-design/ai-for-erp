 {
  "doctype": "Custom HTML Block",
  "html": "<div class=\"srm-section\"><div class=\"srm-intro-title\">SRM Tiles</div><div class=\"srm-intro-text\">Quick links to supplier and SRM pages and reports.</div></div><div class=\"srm-tiles\"><a class=\"srm-tile\" href=\"/app/supplier\"><div class=\"heading\">Suppliers</div><div class=\"title\">Suppliers</div><div class=\"desc\">List of suppliers</div></a><a class=\"srm-tile\" href=\"/app/supplier-change-request\"><div class=\"heading\">Supplier Change Requests</div><div class=\"title\">Supplier Change Requests</div><div class=\"desc\">List of supplier change requests</div></a><a class=\"srm-tile\" href=\"/app/supplier-quotation\"><div class=\"heading\">Supplier Quotations</div><div class=\"title\">Supplier Quotations</div><div class=\"desc\">List of supplier quotations</div></a><a class=\"srm-tile\" href=\"/app/purchase-order\"><div class=\"heading\">Purchase Orders</div><div class=\"title\">Purchase Orders</div><div class=\"desc\">List of purchase orders</div></a><a class=\"srm-tile\" href=\"/app/supplier-c-form\"><div class=\"heading\">Supplier C-Forms</div><div class=\"title\">Supplier C-Forms</div><div class=\"desc\">List of supplier C-Forms</div></a><a class=\"srm-tile\" href=\"/app/bank-guarantee\"><div class=\"heading\">Bank Guarantees</div><div class=\"title\">Bank Guarantees</div><div class=\"desc\">List of bank guarantees</div></a><a class=\"srm-tile\" href=\"/app/branch-price-revision\"><div class=\"heading\">Branch Price Revision</div><div class=\"title\">Branch Price Revision</div><div class=\"desc\">List of branch price revisions</div></a><a class=\"srm-tile\" href=\"/app/supplier-cps\"><div class=\"heading\">Supplier CPS</div><div class=\"title\">Supplier CPS</div><div class=\"desc\">List of supplier CPS</div></a><a class=\"srm-tile\" href=\"/app/supplier-source-declaration\"><div class=\"heading\">Supplier Source Declaration</div><div class=\"title\">Supplier Source Declaration</div><div class=\"desc\">List of supplier source declarations</div></a><a class=\"srm-tile\" href=\"/app/supplier-eligibility\"><div class=\"heading\">Supplier Eligibility</div><div class=\"title\">Supplier Eligibility</div><div class=\"desc\">List of supplier eligibility records</div></a><a class=\"srm-tile\" href=\"/app/non-conformance\"><div class=\"heading\">Non Conformance</div><div class=\"title\">Non Conformance</div><div class=\"desc\">List of non conformances</div></a><a class=\"srm-tile\" href=\"/app/supplier-product-registration\"><div class=\"heading\">Supplier Product Registration</div><div class=\"title\">Supplier Product Registration</div><div class=\"desc\">List of supplier product registrations</div></a><a class=\"srm-tile\" href=\"/app/query-report/Supplier Product Registrations (Summary)\"><div class=\"heading\">Report</div><div class=\"title\">Supplier Product Registrations (Summary)</div><div class=\"desc\">Supplier product registrations (summary report)</div></a><a class=\"srm-tile\" href=\"/app/query-report/Supplier Eligibility Overview (Summary)\"><div class=\"heading\">Report</div><div class=\"title\">Supplier Eligibility Overview (Summary)</div><div class=\"desc\">Supplier eligibility overview (summary report)</div></a><a class=\"srm-tile\" href=\"/app/query-report/Branch Price Revision - Workflow Overview\"><div class=\"heading\">Report</div><div class=\"title\">Branch Price Revision - Workflow Overview</div><div class=\"desc\">Branch price revision workflow overview</div></a><a class=\"srm-tile\" href=\"/app/query-report/Supplier Non Conformances\"><div class=\"heading\">Report</div><div class=\"title\">Supplier Non Conformances</div><div class=\"desc\">Supplier non conformances report</div></a></div>",
  "name": "srm-tiles-block",
  "private": 0,
  "style": ".srm-tiles{display:flex;flex-wrap:wrap;gap:12px}.srm-tile{background:#fff;color:#281868;width:220px;padding:12px;border-radius:8px;text-decoration:none;display:block;border:1px solid #e3dfd9;border-left:4px solid #ff6600;box-sizing:border-box}.srm-tile:hover{background:#fff3ea}.srm-tile .heading{background:#fff3ea;color:#800000;padding:6px 8px;font-weight:600;border-radius:4px;display:inline-block}.srm-tile .title{margin:10px 0 6px;font-size:16px;font-weight:600;color:#281868}.srm-tile .desc{color:#5f6272;font-size:13px}.srm-section{background:#fff3ea;padding:8px;border-radius:8px;margin-bottom:8px}.srm-intro-title{font-weight:700;color:#281868}.srm-intro-text{margin-top:8px;color:#5f6272}"
 },
 {
  "doctype": "Custom HTML Block",
