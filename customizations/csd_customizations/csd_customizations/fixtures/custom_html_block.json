[
 {
  "doctype": "Custom HTML Block",
  "html": "<div class=\"srm-banner\">\n  <div class=\"srm-banner-inner\">\n    <div class=\"srm-banner-title\">demo-pilot</div>\n    <div class=\"srm-banner-sub\">Supplier Relationship Management</div>\n  </div>\n</div>",
  "name": "demo-pilot banner",
  "private": 0,
  "style": ".srm-banner{background:#FFE600;padding:18px 16px;border-radius:4px;margin-bottom:16px;}\n.srm-banner-inner{max-width:1150px;margin:0 auto;}\n.srm-banner-title{font-weight:700;color:#000;font-size:20px;line-height:1;margin-bottom:4px;text-transform:none}\n.srm-banner-sub{color:#000;font-size:14px;opacity:0.95}\n/* ensure block spacing */\n.srm-banner, .srm-tiles{box-sizing:border-box}"
 },
