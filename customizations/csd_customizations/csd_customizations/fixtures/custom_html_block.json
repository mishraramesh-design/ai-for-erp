  "style": ".csdh{max-width:1100px;margin:0 auto;padding:4px 2px 24px;font-family:inherit}.csdh-hero{display:flex;align-items:center;gap:16px;background:#f8e3d6;border:1px solid #e6c9b6;border-radius:8px 8px 0 0;padding:18px 22px}.csdh-mark{background:#281868;color:#fff;font-weight:700;font-size:18px;letter-spacing:1px;padding:10px 14px;border-radius:6px}.csdh-title{font-size:22px;font-weight:700;color:#281868}.csdh-sub{font-size:13px;color:#5b6172;margin-top:2px}.csdh-rules{display:flex;height:4px;margin-bottom:24px;border-radius:0 0 8px 8px;overflow:hidden}.csdh-rules i{flex:1;display:block}.csdh-rules i:nth-child(1){background:#ff6600}.csdh-rules i:nth-child(2){background:#fff;box-shadow:inset 0 1px 0 #d9dce4,inset 0 -1px 0 #d9dce4}.csdh-rules i:nth-child(3){background:#0d8a00}.csdh-group{margin-bottom:24px}.csdh-gh{display:flex;flex-wrap:wrap;align-items:baseline;gap:10px;margin-bottom:10px;padding-bottom:6px;border-bottom:1px solid #e3dfd9}.csdh-gt{font-size:15px;font-weight:700;color:#281868}.csdh-gs{font-size:12px;color:#5b6172}.csdh-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(122px,1fr));gap:12px}.csdh-tile{display:flex;flex-direction:column;align-items:center;gap:8px;text-decoration:none;padding:14px 6px 12px;border-radius:8px;border:1px solid #e3dfd9;background:#fff;transition:border-color .15s,box-shadow .15s}.csdh-tile:hover{border-color:#ff6600;box-shadow:0 6px 16px -10px rgba(255,102,0,.55);text-decoration:none}.csdh-ico{display:flex;align-items:center;justify-content:center;width:56px;height:56px;border-radius:12px;color:#fff}.csdh-lb{font-size:12.5px;font-weight:600;color:#1b1e2b;text-align:center;line-height:1.25}.c1 .csdh-ico{background:#281868}.c2 .csdh-ico{background:#ff6600;color:#1c1150}.c3 .csdh-ico{background:#0d8a00}.c4 .csdh-ico{background:#800000}.c5 .csdh-ico{background:#0a98d8}"
 }
