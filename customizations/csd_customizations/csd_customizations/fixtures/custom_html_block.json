 {
  "doctype": "Custom HTML Block",
  "html": "<div class=\"scm-banner\"><h1>SCM Executive BI</h1><p>Supplier Relationship Management — Live Insights</p></div>",
  "name": "SCM BI Banner",
  "private": 0,
  "style": ":root{--black:#000000;--ey:#FFE600;--white:#FFFFFF}.scm-banner{background:var(--black);color:var(--white);padding:16px 20px;border-left:6px solid var(--ey)}.scm-banner h1{color:var(--ey);margin:0;font-weight:700;letter-spacing:.3px}.scm-banner p{margin:4px 0 0;color:var(--white)}"
