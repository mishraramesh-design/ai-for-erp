  "style": ".csdh{max-width:1100px;margin:0 auto;padding:4px 2px 24px;font-family:inherit}.csdh-hero{display:flex;align-items:center;gap:16px;background:#111;color:#fff;border-bottom:4px solid #FFD400;border-radius:14px;padding:18px 22px;margin-bottom:22px}.csdh-mark{background:#FFD400;color:#111;font-weight:800;font-size:20px;letter-spacing:1px;padding:10px 14px;border-radius:12px}.csdh-title{font-size:22px;font-weight:700}.csdh-sub{font-size:13px;color:#d8d3c4;margin-top:2px}.csdh-group{margin-bottom:22px}.csdh-gh{display:flex;flex-wrap:wrap;align-items:baseline;gap:10px;margin-bottom:10px;border-left:4px solid #FFD400;padding-left:10px}.csdh-gt{font-size:16px;font-weight:700;color:#111}.csdh-gs{font-size:12px;color:#6b665a}.csdh-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:14px}.csdh-tile{display:flex;flex-direction:column;align-items:center;gap:8px;text-decoration:none;padding:14px 6px 12px;border-radius:16px;border:1px solid #e2dccb;background:#fff;transition:transform .15s,box-shadow .15s}.csdh-tile:hover{transform:translateY(-3px);box-shadow:0 8px 18px rgba(0,0,0,.12);text-decoration:none}.csdh-ico{display:flex;align-items:center;justify-content:center;width:62px;height:62px;border-radius:18px}.csdh-lb{font-size:12.5px;font-weight:600;color:#111;text-align:center;line-height:1.25}.c1 .csdh-ico{background:#FFD400;color:#111}.c2 .csdh-ico{background:#111;color:#FFD400}.c3 .csdh-ico{background:#F1EBDD;color:#111;box-shadow:inset 0 0 0 2px #111}.c4 .csdh-ico{background:#2B2B2B;color:#FFD400}.c5 .csdh-ico{background:#fff;color:#111;box-shadow:inset 0 0 0 2px #FFD400}"
 }
