lb\">Purchase Invoices</span></a><a class=\"csdh-tile c3\" href=\"/app/sales-invoice\"><span class=\"csdh-ico\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 3h8l4 4v14H6z\"/><path d=\"M14 3v4h4M9 12h6M9 16h6\"/></svg></span><span class=\"csdh-lb\">Sales Invoices</span></a><a class=\"csdh-tile c3\" href=\"/app/payment-entry\"><span class=\"csdh-ico\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 7h16a2 2 0 012 2v9a2 2 0 01-2 2H3z\"/><path d=\"M3 7l12-3v3\"/><circle cx=\"16.5\" cy=\"13.5\" r=\"1.3\"/></svg></span><span class=\"csdh-lb\">Payment Entries</span></a><a class=\"csdh-tile c3\" href=\"/app/journal-entry\"><span class=\"csdh-ico\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 4h12a2 2 0 012 2v14H7a2 2 0 01-2-2z\"/><path d=\"M5 18a2 2 0 012-2h12\"/></svg></span><span class=\"csdh-lb\">Journal Entries</span></a><a class=\"csdh-tile c3\" href=\"/app/bank-reconciliation-tool\"><span class=\"csdh-ico\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 9l9-5 9 5\"/><path d=\"M5 10v8M10 10v8M14 10v8M19 10v8M3 20h18\"/></svg></span><span class=\"csdh-lb\">Bank Reconciliation</span></a><a class=\"csdh-tile c3\" href=\"/app/budget\"><span class=\"csdh-ico\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3v9h9\"/><path d=\"M20 15a8 8 0 11-11-11\"/></svg></span><span class=\"csdh-lb\">Budgets</span></a><a class=\"csdh-tile c3\" hre