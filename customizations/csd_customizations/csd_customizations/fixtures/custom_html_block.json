 {
  "doctype": "Custom HTML Block",
  "html": "<style>\n  /* Tile container */\n  .srm-tiles { display:flex; flex-wrap:wrap; gap:12px; }\n  .srm-tile { background:#000; color:#fff; width:220px; padding:12px; border-radius:6px; text-decoration:none; display:block; }\n  .srm-tile .heading { background:#FFE600; color:#000; padding:6px 8px; font-weight:600; border-radius:4px; display:inline-block; }\n  .srm-tile .title { margin:10px 0 6px; font-size:16px; font-weight:600; color:#fff; }\n  .srm-tile .desc { color:#eee; font-size:13px; }\n  .srm-section { background:#F2F2F2; padding:8px; border-radius:6px; margin-bottom:8px; }\n</style>\n\n<div class=\"srm-section\">\n  <div style=\"font-weight:700;color:#333;\">SRM Tiles</div>\n  <div style=\"margin-top:8px;color:#555;\">Quick links to supplier and SRM pages and reports.</div>\n</div>\n\n<div class=\"srm-tiles\">\n  <!-- Original four tiles -->\n  <a class=\"srm-tile\" href=\"/app/supplier\">\n    <div class=\"heading\">Suppliers</div>\n    <div class=\"title\">Suppliers</div>\n    <div class=\"desc\">List of suppliers</div>\n  </a>\n\n  <a class=\"srm-tile\" href=\"/app/supplier-change-request\">\n    <div class=\"heading\">Supplier Change Requests</div>\n    <div class=\"title\">Supplier Change Requests</div>\n    <div class=\"desc\">List of supplier change requests</div>\n  </a>\n\n  <a class=\"srm-tile\" href=\"/app/supplier-quotation\">\n    <div class=\"heading\">Supplier Quotations</div>\n    <div class=\"title\">Supplier Quotations</div>\n    <div class=\"desc\">List of supplier quotations</div>\n  </a>\n\n  <a class=\"srm-tile\" href=\"/app/purchase-order\">\n    <div class=\"heading\">Purchase Orders</div>\n    <div class=\"title\">Purchase Orders</div>\n    <div class=\"desc\">List of purchase orders</div>\n  </a>\n\n  <!-- Eight new tiles -->\n  <a class=\"srm-tile\" href=\"/app/supplier-c-form\">\n    <div class=\"heading\">Supplier C-Forms</div>\n    <div class=\"title\">Supplier C-Forms</div>\n    <div class=\"desc\">List of supplier C-Forms</div>\n  </a>\n\n  <a class=\"srm-tile\" href=\"/app/bank-guarantee\">\n    <div class=\"heading\">Bank Guarantees</div>\n    <div class=\"title\">Bank Guarantees</div>\n    <div class=\"desc\">List of bank guarantees</div>\n  </a>\n\n  <a class=\"srm-tile\" href=\"/app/branch-price-revision\">\n    <div class=\"heading\">Branch Price Revision</div>\n    <div class=\"title\">Branch Price Revision</div>\n    <div class=\"desc\">List of branch price revisions</div>\n  </a>\n\n  <a class=\"srm-tile\" href=\"/app/supplier-cps\">\n    <div class=\"heading\">Supplier CPS</div>\n    <div class=\"title\">Supplier CPS</div>\n    <div class=\"desc\">List of supplier CPS</div>\n  </a>\n\n  <a class=\"srm-tile\" href=\"/app/supplier-source-declaration\">\n    <div class=\"heading\">Supplier Source Declaration</div>\n    <div class=\"title\">Supplier Source Declaration</div>\n    <div class=\"desc\">List of supplier source declarations</div>\n  </a>\n\n  <a class=\"srm-tile\" href=\"/app/supplier-eligibility\">\n    <div class=\"heading\">Supplier Eligibility</div>\n    <div class=\"title\">Supplier Eligibility</div>\n    <div class=\"desc\">List of supplier eligibility records</div>\n  </a>\n\n  <a class=\"srm-tile\" href=\"/app/non-conformance\">\n    <div class=\"heading\">Non Conformance</div>\n    <div class=\"title\">Non Conformance</div>\n    <div class=\"desc\">List of non conformances</div>\n  </a>\n\n  <a class=\"srm-tile\" href=\"/app/supplier-product-registration\">\n    <div class=\"heading\">Supplier Product Registration</div>\n    <div class=\"title\">Supplier Product Registration</div>\n    <div class=\"desc\">List of supplier product registrations</div>\n  </a>\n\n  <!-- Report shortcuts (query-report routes where applicable) -->\n  <a class=\"srm-tile\" href=\"/app/query-report/Supplier Product Registrations (Summary)\">\n    <div class=\"heading\">Report</div>\n    <div class=\"title\">Supplier Product Registrations (Summary)</div>\n    <div class=\"desc\">Supplier product registrations (summary report)</div>\n  </a>\n\n  <a class=\"srm-tile\" href=\"/app/query-report/Supplier Eligibility Overview (Summary)\">\n    <div class=\"heading\">Report</div>\n    <div class=\"title\">Supplier Eligibility Overview (Summary)</div>\n    <div class=\"desc\">Supplier eligibility overview (summary report)</div>\n  </a>\n\n  <a class=\"srm-tile\" href=\"/app/query-report/Branch Price Revision - Workflow Overview\">\n    <div class=\"heading\">Report</div>\n    <div class=\"title\">Branch Price Revision - Workflow Overview</div>\n    <div class=\"desc\">Branch price revision workflow overview</div>\n  </a>\n\n  <a class=\"srm-tile\" href=\"/app/query-report/Supplier Non Conformances\">\n    <div class=\"heading\">Report</div>\n    <div class=\"title\">Supplier Non Conformances</div>\n    <div class=\"desc\">Supplier non conformances report</div>\n  </a>\n</div>",
  "name": "srm-tiles-block",
  "private": 0,
  "style": ""
 },
 {
