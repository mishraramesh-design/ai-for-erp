  "style": ".case-banner{background:#f8e3d6;border-left:6px solid #ff6600;border-bottom:3px solid #0d8a00;border-radius:8px;padding:18px;border-radius:10px}.case-banner .case-topbar{height:4px;background:linear-gradient(90deg,#ff6600 0 33%,#ffffff 33% 66%,#0d8a00 66% 100%);border:1px solid #e3dfd9;border-radius:2px;margin-bottom:10px}.case-banner h1{margin:0;font-size:28px;font-weight:800;color:#281868}.case-banner p{margin:4px 0 0;font-size:14px;color:#5f6272}"
 },
 {
  "doctype": "Custom HTML Block",
  "html": "<div class=\"case-tiles\"><a href=\"/app/case\"><div>Cases</div><div class=\"caption\">All cases</div></a><a href=\"/app/case/new\"><div>New Case</div><div class=\"caption\">Register a case</div></a><a href=\"/app/dashboard-view/Case Dashboard\"><div>Case Dashboard</div><div class=\"caption\">Management view</div></a><a href=\"/app/query-report/Case Lifecycle\"><div>Case Lifecycle</div><div class=\"caption\">Status and owners</div></a><a href=\"/app/query-report/Case Ageing\"><div>Case Ageing</div><div class=\"caption\">Days open</div></a></div>",
  "name": "Case Tiles",
  "private": 0,
  "style": ".case-tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}.case-tiles a{display:block;background:#fff;color:#281868 !important;border:1px solid #e3dfd9;border-left:6px solid #ff6600;border-radius:10px;padding:18px;text-decoration:none;font-weight:700;font-size:16px}.case-tiles a:hover{background:#fff3ea}.case-tiles .caption{color:#5f6272;font-size:12px;margin-top:6px;font-weight:400}"
 },
