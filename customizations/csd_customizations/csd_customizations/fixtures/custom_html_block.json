 {
  "doctype": "Custom HTML Block",
  "html": "<div class=\"srm-tiles\">\n  <div class=\"srm-tiles-inner\">\n    <div class=\"srm-section\">\n      <div class=\"srm-section-heading\">Onboarding</div>\n      <div class=\"srm-tiles-row\">\n        <a class=\"srm-tile\" href=\"/app/supplier\">Suppliers</a>\n        <a class=\"srm-tile\" href=\"/app/supplier-change-request\">Supplier Change Requests</a>\n        <a class=\"srm-tile\" href=\"/app/supplier-quotation\">Supplier Quotations</a>\n        <a class=\"srm-tile\" href=\"/app/purchase-order\">Purchase Orders</a>\n      </div>\n    </div>\n\n    <div class=\"srm-section\">\n      <div class=\"srm-section-heading\">Products &amp; Prices</div>\n      <div class=\"srm-tiles-row\">\n        <a class=\"srm-tile\" href=\"/app/supplier-product-registration\">Supplier Product Registration</a>\n        <a class=\"srm-tile\" href=\"/app/supplier-c-form\">Supplier C-Form</a>\n        <a class=\"srm-tile\" href=\"/app/supplier-cps\">Supplier CPS</a>\n        <a class=\"srm-tile\" href=\"/app/bank-guarantee\">Bank Guarantee</a>\n      </div>\n    </div>\n\n    <div class=\"srm-section\">\n      <div class=\"srm-section-heading\">Compliance</div>\n      <div class=\"srm-tiles-row\">\n        <a class=\"srm-tile\" href=\"/app/branch-price-revision\">Branch Price Revision</a>\n        <a class=\"srm-tile\" href=\"/app/supplier-source-declaration\">Supplier Source Declaration</a>\n        <a class=\"srm-tile\" href=\"/app/supplier-eligibility\">Supplier Eligibility</a>\n        <a class=\"srm-tile\" href=\"/app/non-conformance\">Non Conformance</a>\n      </div>\n    </div>\n\n    <div class=\"srm-section\">\n      <div class=\"srm-section-heading\">Quality</div>\n      <div class=\"srm-tiles-row\">\n        <a class=\"srm-tile\" href=\"/app/supplier-product-registration\">Supplier Product Registration</a>\n        <a class=\"srm-tile\" href=\"/app/supplier-eligibility\">Supplier Eligibility</a>\n        <a class=\"srm-tile\" href=\"/app/non-conformance\">Non Conformance</a>\n        <a class=\"srm-tile\" href=\"/app/supplier-quotation\">Supplier Quotations</a>\n      </div>\n    </div>\n\n    <div class=\"srm-reports\">\n      <div class=\"srm-reports-heading\">Reports</div>\n      <div class=\"srm-tiles-row\">\n        <a class=\"srm-report\" href=\"/app/query-report/Supplier Product Registrations (Summary)\">Supplier Product Registrations (Summary)</a>\n        <a class=\"srm-report\" href=\"/app/query-report/Pending C-Forms\">Pending C-Forms</a>\n        <a class=\"srm-report\" href=\"/app/query-report/Supplier C-Form Pending Approval\">Supplier C-Form Pending Approval</a>\n        <a class=\"srm-report\" href=\"/app/query-report/Supplier Eligibility Overview (Summary)\">Supplier Eligibility Overview (Summary)</a>\n        <a class=\"srm-report\" href=\"/app/query-report/Supplier Non Conformances\">Supplier Non Conformances</a>\n        <a class=\"srm-report\" href=\"/app/query-report/Branch Price Revision - Workflow Overview\">Branch Price Revision - Workflow Overview</a>\n      </div>\n    </div>\n\n  </div>\n</div>",
  "name": "SRM Tiles",
  "private": 0,
  "style": ".srm-tiles{max-width:1200px;margin:0 auto;padding:8px 0}\n.srm-section{margin-bottom:18px}\n.srm-section-heading{background:#F2F2F2;color:#222;padding:8px 12px;font-weight:600;border-radius:4px;margin-bottom:8px}\n.srm-tiles-row{display:flex;flex-wrap:wrap;gap:10px}\n.srm-tile{display:inline-block;padding:12px 14px;background:#000;color:#FFE600;text-decoration:none;border-radius:6px;font-weight:600}\n.srm-tile:hover{opacity:0.9}\n.srm-report{display:inline-block;padding:10px 12px;background:#111;color:#fff;border-left:6px solid #FFE600;text-decoration:none;border-radius:4px}\n.srm-reports-heading{font-weight:700;color:#222;margin:8px 0}\n/* responsive */\n@media (max-width:700px){.srm-tiles-inner{padding:0 10px}.srm-tiles-row{flex-direction:column}.srm-tile,.srm-report{width:100%}}"
 },
