 {
  "doctype": "Custom HTML Block",
  "html": "<div class=\"csdh\"><div class=\"csdh-hero\"><div class=\"csdh-mark\">CSD</div><div><div class=\"csdh-title\">Command Centre</div><div class=\"csdh-sub\">One launcher for supply chain, warehouses, finance and suppliers. Pick a tile to open the screen.</div></div></div><div class=\"csdh-group\"><div class=\"csdh-gh\"><span class=\"csdh-gt\">Supply Chain Management</span><span class=\"csdh-gs\">Plan demand, raise indents and place orders</span></div><div class=\"csdh-grid\"><a class=\"csdh-tile c1\" href=\"/app/material-request\"><span class=\"csdh-ico\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 4h6v3H9z\"/><path d=\"M7 5H5v15h14V5h-2\"/><path d=\"M9 11h6M9 15h4\"/></svg></span><span class=\"csdh-lb\">Material Requests</span></a><a class=\"csdh-tile c1\" href=\"/app/purchase-order\"><span class=\"csdh-ico\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"9\" cy=\"19\" r=\"1.5\"/><circle cx=\"17\" cy=\"19\" r=\"1.5\"/><path d=\"M3 4h2.5l2 10h10l2-7H7\"/></svg></span><span class=\"csdh-lb\">Purchase Orders</span></a><a class=\"csdh-tile c1\" href=\"/app/consolidated-demand\"><span class=\"csdh-ico\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 4l9 5-9 5-9-5z\"/><path d=\"M3 14l9 5 9-5\"/></svg></span><span class=\"csdh-lb\">Consolidated Demand</span></a><a class=\"csdh-tile c1\" href=\"/app/liquor-demand-forecast\"><span class=\"csdh-ico\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 19V5\"/><path d=\"M4 19h16\"/><path d=\"M7 15l4-4 3 3 5-6\"/></svg></span><span class=\"csdh-lb\">Demand Forecast</span></a><a class=\"csdh-tile c1\" href=\"/app/scm-market-intelligence\"><span class=\"csdh-ico\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"8\"/><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 12l6-6\"/></svg></span><span class=\"csdh-lb\">Market Intelligence</span></a><a class=\"csdh-tile c1\" href=\"/app/branch-price-revision\"><span class=\"csdh-ico\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 12V4h8l10 10-8 8z\"/><circle cx=\"8\" cy=\"9\" r=\"1.5\"/></svg></span><span class=\"csdh-lb\">Price Revisions</span></a></div></div><div class=\"csdh-group\"><div class=\"csdh-gh\"><span class=\"csdh-gt\">Warehouse Management</span><span class=\"csdh-gs\">Receive, store and move stock across depots</span></div><div class=\"csdh-grid\"><a class=\"csdh-tile c2\" href=\"/app/purchase-receipt\"><span class=\"csdh-ico\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 13l3-8h12l3 8v6H3z\"/><path d=\"M3 13h5l1 3h6l1-3h5\"/></svg></span><span class=\"csdh-lb\">Purchase Receipts</span></a><a class=\"csdh-tile c2\" href=\"/app/delivery-note\"><span class=\"csdh-ico\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2 6h11v10H2z\"/><path d=\"M13 9h5l3 3v4h-8\"/><circle cx=\"6\" cy=\"18\" r=\"1.8\"/><circle cx=\"17\" cy=\"18\" r=\"1.8\"/></svg></span><span class=\"csdh-lb\">Delivery Notes</span></a><a class=\"csdh-tile c2\" href=\"/app/stock-entry\"><span class=\"csdh-ico\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 8h14l-3-3\"/><path d=\"M20 16H6l3 3\"/></svg></span><span class=\"csdh-lb\">Stock Entries</span></a><a class=\"csdh-tile c2\" href=\"/app/query-report/Stock%20Balance\"><span class=\"csdh-ico\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 8l9-4 9 4v9l-9 4-9-4z\"/><path d=\"M3 8l9 4 9-4M12 12v9\"/></svg></span><span class=\"csdh-lb\">Stock Balance</span></a><a class=\"csdh-tile c2\" href=\"/app/warehouse\"><span class=\"csdh-ico\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 20V8l8-4 8 4v12\"/><path d=\"M9 20v-6h6v6\"/></svg></span><span class=\"csdh-lb\">Warehouses</span></a><a class=\"csdh-tile c2\" href=\"/app/non-conformance\"><span class=\"csdh-ico\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3l10 18H2z\"/><path d=\"M12 10v5M12 18v.5\"/></svg></span><span class=\"csdh-lb\">Non Conformance</span></a></div></div><div class=\"csdh-group\"><div class=\"csdh-gh\"><span class=\"csdh-gt\">Finance and Accounts</span><span class=\"csdh-gs\">Bill, pay, reconcile and control budgets</span></div><div class=\"csdh-grid\"><a class=\"csdh-tile c3\" href=\"/app/purchase-invoice\"><span class=\"csdh-ico\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 3h12v18l-3-2-3 2-3-2-3 2z\"/><path d=\"M9 8h6M9 12h6\"/></svg></span><span class=\"csdh-lb\">Purchase Invoices</span></a><a class=\"csdh-tile c3\" href=\"/app/sales-invoice\"><span class=\"csdh-ico\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 3h8l4 4v14H6z\"/><path d=\"M14 3v4h4M9 12h6M9 16h6\"/></svg></span><span class=\"csdh-lb\">Sales Invoices</span></a><a class=\"csdh-tile c3\" href=\"/app/payment-entry\"><span class=\"csdh-ico\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 7h16a2 2 0 012 2v9a2 2 0 01-2 2H3z\"/><path d=\"M3 7l12-3v3\"/><circle cx=\"16.5\" cy=\"13.5\" r=\"1.3\"/></svg></span><span class=\"csdh-lb\">Payment Entries</span></a><a class=\"csdh-tile c3\" href=\"/app/journal-entry\"><span class=\"csdh-ico\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 4h12a2 2 0 012 2v14H7a2 2 0 01-2-2z\"/><path d=\"M5 18a2 2 0 012-2h12\"/></svg></span><span class=\"csdh-lb\">Journal Entries</span></a><a class=\"csdh-tile c3\" href=\"/app/bank-reconciliation-tool\"><span class=\"csdh-ico\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 9l9-5 9 5\"/><path d=\"M5 10v8M10 10v8M14 10v8M19 10v8M3 20h18\"/></svg></span><span class=\"csdh-lb\">Bank Reconciliation</span></a><a class=\"csdh-tile c3\" href=\"/app/budget\"><span class=\"csdh-ico\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3v9h9\"/><path d=\"M20 15a8 8 0 11-11-11\"/></svg></span><span class=\"csdh-lb\">Budgets</span></a><a class=\"csdh-tile c3\" href=\"/app/urc-payment-advice\"><span class=\"csdh-ico\"><svg viewBox