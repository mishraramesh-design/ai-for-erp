 {
  "doctype": "Custom HTML Block",
  "html": "<div class=\"srm-tiles\"><div class=\"srm-tiles-inner\"><div class=\"srm-section\"><div class=\"srm-section-heading\">Onboarding</div><div class=\"srm-tiles-row\"><a class=\"srm-tile\" href=\"/app/supplier\">Suppliers</a><a class=\"srm-tile\" href=\"/app/supplier-change-request\">Supplier Change Requests</a><a class=\"srm-tile\" href=\"/app/supplier-quotation\">Supplier Quotations</a><a class=\"srm-tile\" href=\"/app/purchase-order\">Purchase Orders</a></div></div><div class=\"srm-section\"><div class=\"srm-section-heading\">Products &amp; Prices</div><div class=\"srm-tiles-row\"><a class=\"srm-tile\" href=\"/app/supplier-product-registration\">Supplier Product Registration</a><a class=\"srm-tile\" href=\"/app/supplier-c-form\">Supplier C-Form</a><a class=\"srm-tile\" href=\"/app/supplier-cps\">Supplier CPS</a><a class=\"srm-tile\" href=\"/app/bank-guarantee\">Bank Guarantee</a></div></div><div class=\"srm-section\"><div class=\"srm-section-heading\">Compliance</div><div class=\"srm-tiles-row\"><a class=\"srm-tile\" href=\"/app/branch-price-revision\">Branch Price Revision</a><a class=\"srm-tile\" href=\"/app/supplier-source-declaration\">Supplier Source Declaration</a><a class=\"srm-tile\" href=\"/app/supplier-eligibility\">Supplier Eligibility</a><a class=\"srm-tile\" href=\"/app/non-conformance\">Non Conformance</a></div></div><div class=\"srm-section\"><div class=\"srm-section-heading\">Quality</div><div class=\"srm-tiles-row\"><a class=\"srm-tile\" href=\"/app/supplier-product-registration\">Supplier Product Registration</a><a class=\"srm-tile\" href=\"/app/supplier-eligibility\">Supplier Eligibility</a><a class=\"srm-tile\" href=\"/app/non-conformance\">Non Conformance</a><a class=\"srm-tile\" href=\"/app/supplier-quotation\">Supplier Quotations</a></div></div><div class=\"srm-reports\"><div class=\"srm-reports-heading\">Reports</div><div class=\"srm-tiles-row\"><a class=\"srm-report\" href=\"/app/query-report/Supplier Product Registrations (Summary)\">Supplier Product Registrations (Summary)</a><a class=\"srm-report\" href=\"/app/query-report/Pending C-Forms\">Pending C-Forms</a><a class=\"srm-report\" href=\"/app/query-report/Supplier C-Form Pending Approval\">Supplier C-Form Pending Approval</a><a class=\"srm-report\" href=\"/app/query-report/Supplier Eligibility Overview (Summary)\">Supplier Eligibility Overview (Summary)</a><a class=\"srm-report\" href=\"/app/query-report/Supplier Non Conformances\">Supplier Non Conformances</a><a class=\"srm-report\" href=\"/app/query-report/Branch Price Revision - Workflow Overview\">Branch Price Revision - Workflow Overview</a></div></div></div></div>",
  "name": "SRM Tiles",
  "private": 0,
  "style": ".srm-tiles{max-width:1200px;margin:0 auto;padding:8px 0}.srm-section{margin-bottom:18px}.srm-section-heading{background:#fff3ea;color:#800000;padding:8px 12px;font-weight:600;border-radius:6px;border-left:4px solid #ff6600;margin-bottom:8px}.srm-tiles-row{display:flex;flex-wrap:wrap;gap:10px}.srm-tile{display:inline-block;padding:12px 16px;background:#fff;color:#281868;text-decoration:none;border-radius:8px;font-weight:600;border:1px solid #e3dfd9;border-left:4px solid #ff6600}.srm-tile:hover{background:#fff3ea;border-color:#ff6600}.srm-report{display:inline-block;padding:10px 14px;background:#fff;color:#281868;border:1px solid #e3dfd9;border-left:4px solid #800000;text-decoration:none;border-radius:8px}.srm-report:hover{background:#fff3ea}.srm-reports-heading{font-weight:700;color:#281868;margin:8px 0}@media (max-width:700px){.srm-tiles-row{flex-direction:column}.srm-tile,.srm-report{width:100%;box-sizing:border-box}}"
 },
