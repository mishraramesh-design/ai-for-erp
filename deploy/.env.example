# Copy to .env (install-studio.sh does this for you). Never commit .env.
DOCKERHUB_NAMESPACE=your-dockerhub-username
STUDIO_TAG=studio-latest
STUDIO_PORT=18100
# Password for the Studio web UI
STUDIO_ADMIN_PASSWORD=change-me
# Secret used to encrypt stored credentials (generated by install-studio.sh)
STUDIO_SECRET_KEY=change-me
# Model access (entered through a hidden prompt by install-studio.sh)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
